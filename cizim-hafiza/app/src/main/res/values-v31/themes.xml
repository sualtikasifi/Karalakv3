<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 12+ draws the splash itself rather than through the compat
        library, and only this platform version understands
        windowSplashScreenAnimationDuration. Declaring it in the base
        values/ folder would be a no-op the compat path silently ignores,
        so it lives here instead of pretending to apply everywhere.

        The duration is a hint to the system about how long the icon's own
        animation runs; it does NOT hold the app back. It matches
        MainActivity.SPLASH_EXIT_MILLIS and BrandSplash's opening hold —
        the mark is static here and only starts moving once Compose has
        taken the screen over. Nothing delays startup on purpose: a splash
        that outstays the work it is covering is just a slower app.
    -->
    <style name="Theme.Karalak.Splash" parent="Theme.SplashScreen">
        <!-- See the base values/themes.xml copy of this style for why this
             line is here: the classic starting-window background, painted
             before windowSplashScreenBackground below ever takes effect. -->
        <!-- No system "starting window" at all: that window is a plain colour (the brown players kept seeing for a
             moment before the opening scene). Without it the launcher stays on screen until the app draws its first
             frame, and that frame is already the opening scene (see MainActivity / SplashSceneDrawable). -->
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- Android 12+ always shows this system splash on launch (it cannot be turned off, and it can only hold a
             colour and one centred icon, never a full picture). Left empty it read as a plain brown screen, so it
             carries the round Karalak logo; the painted scene then fades in over it (see MainActivity). The logo
             fills 64% of its canvas so the platform's circular icon mask (2/3 of the canvas) never clips its rim. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">180</item>
        <item name="postSplashScreenTheme">@style/Theme.CizimHafiza</item>
    </style>
</resources>
