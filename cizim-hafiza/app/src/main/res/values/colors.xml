<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches the Karalak logo's white backdrop so the adaptive icon reads cleanly. -->
    <color name="launcher_background">#F6A21E</color>
    <!-- App's cream background (Compose CreamBackground) — used for the splash
         screen and as the base window background so cold start never shows a
         plain white flash before Compose paints its first frame. -->
    <color name="splash_background">#B07F34</color>
    <!-- The system splash's flat colour: the average colour of the opening scene, so the scene appearing over it is a change of detail, not of colour. -->
    <color name="splash_screen_background">#B0843E</color>
</resources>
