<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all theming (see ui/theme/Theme.kt); this is only the
         splash-to-first-frame window background required by the manifest.
         windowBackground is set explicitly to the app's cream color (not
         left as the platform default white) so there's no color mismatch
         flash between the OS splash screen and Compose's first frame. -->
    <!-- Parent is an AppCompat theme (not a plain platform theme) because
         MainActivity extends AppCompatActivity — required for per-app
         language switching (AppCompatDelegate.setApplicationLocales), which
         throws at runtime without it. Doesn't change how anything looks;
         Compose still owns every visible color/shape. -->
    <style name="Theme.CizimHafiza" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <!-- Shown for the brief window between process start and Compose's first
         frame (see MainActivity.installSplashScreen()). Hands off to
         Theme.CizimHafiza automatically once the app is ready to draw.

         The icon is the round Karalak logo as a vector (@drawable/splash_icon), see below. -->
    <style name="Theme.Karalak.Splash" parent="Theme.SplashScreen">
        <!-- The classic starting-window attribute, not just
             windowSplashScreenBackground below. Android paints a "starting
             window" using android:windowBackground THE INSTANT a window is
             created — before the SplashScreen APIs, or this app's own code,
             ever run — as the standard mechanism to avoid a blank/black
             frame during any window creation, cold start or recreate alike.
             This theme never set it, leaving that instant to whatever the
             platform/OEM default is (black on some skins, notably MIUI) for
             every recreate this Activity goes through — including the one
             AppCompatDelegate.setApplicationLocales() triggers on a
             language switch, which is exactly what kept flashing dark
             despite windowSplashScreenBackground already being correct. -->
        <!-- No system "starting window" at all: that window is a plain colour (the brown players kept seeing for a
             moment before the opening scene). Without it the launcher stays on screen until the app draws its first
             frame, and that frame is already the opening scene (see MainActivity / SplashSceneDrawable). -->
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@drawable/splash_scene_window</item>
        <item name="windowSplashScreenBackground">@android:color/transparent</item>
        <!-- Android 12+ always opens on this system splash (it cannot be turned off and holds only a colour and one
             icon). Built the way the platform guidelines ask: one light, flat colour and the logo as a vector that
             animates in (under 1 s). MainActivity holds it until the painted opening scene is drawn underneath,
             then it rises off the scene like a curtain. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.CizimHafiza</item>
    </style>
</resources>
