<?xml version="1.0" encoding="utf-8"?>
<!-- Only the "already asked" facts (rating prompt, Quick Match count) are carried by Android's own backup. The Room
     database is deliberately NOT: it holds achievements (with whether each reward was collected) and game history, and
     an older copy of it restored next to the account's progress — which comes from Firestore — let rewards be
     collected a second time after a reinstall. Everything that belongs to a player comes back from their account. -->
<full-backup-content>
    <include domain="sharedpref" path="one_time_flags.xml" />
</full-backup-content>
