<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ equivalent of backup_rules.xml (which only older versions read) — see the note there for why the
     database is left out. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="one_time_flags.xml" />
        <include domain="file" path="studio_end_voice/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="one_time_flags.xml" />
        <include domain="file" path="studio_end_voice/" />
    </device-transfer>
</data-extraction-rules>
