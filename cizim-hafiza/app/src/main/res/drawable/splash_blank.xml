<?xml version="1.0" encoding="utf-8"?>
<!-- The system splash's icon, left empty on purpose: the OS shows only the field colour for the instant before the
     app draws, and BrandSplash's painted scene follows straight away — no logo on a plain background in between. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#00000000" />
    <size android:width="24dp" android:height="24dp" />
</shape>
