<?xml version="1.0" encoding="utf-8"?>
<!-- The opening scene as the theme's window background, so whatever the system shows before the app's first frame is
     the scene itself (not a plain colour). Stretched to the screen: the picture is within a few percent of every
     modern phone's shape, and this is on screen for a fraction of a second before the app draws the exact crop. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="@color/splash_screen_background" /></shape></item>
    <item>
        <bitmap android:src="@drawable/splash_art" android:gravity="fill" />
    </item>
</layer-list>
