rules_version = '2';

// Security rules for Karalak.
// Apply in the Firebase console: Firestore Database → Rules → paste this →
// Publish. Deployment is also automated — see .github/workflows/firebase-deploy.yml,
// which is the mechanism that keeps this file and the live rules from
// drifting apart (they have before).
//
// Design note: these rules are *field-scoped*, not just document-scoped. An
// earlier revision granted any listed player blanket `update` on the whole
// room document, which let anyone in a lobby rewrite everyone else's score,
// seize hostUid, or kick players without being host. Every multi-writer
// document below now constrains WHICH keys a given caller may move.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- shared helpers -------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // The one account allowed to moderate: approve a round into the pool,
    // pull one back out, and write the penalty that follows a rejection.
    //
    // An identity rather than a role because Firestore rules have no notion
    // of one and this game has exactly one moderator. It is also the only
    // honest way to write these rules: the passcode in front of the review
    // screen lives in an APK anyone can unzip, so it stops accidents, not
    // attackers — without this the moderation collections were open to every
    // signed-in player, which meant anybody could have written a penalty
    // against anybody else and taken their XP.
    //
    // The VERIFIED EMAIL, not the uid. This was a uid, and it stopped working
    // the first time the app was uninstalled and reinstalled: the install
    // creates a fresh anonymous account before it links Google, and the uid
    // that comes out the other side is not the one that went in. The panel
    // then refused every write with nothing to explain why. An address
    // survives a reinstall; a uid does not.
    //
    // email_verified matters: without it, anyone could register an
    // email/password account claiming this address and moderate. Google
    // sign-in sets it; a self-asserted address does not.
    function reviewer() {
      return signedIn()
             && request.auth.token.email == 'raunen3075@gmail.com'
             && request.auth.token.email_verified == true;
    }

    // The permanent shared practice room driven by BotRoomEngine.kt. The bot
    // has no Firebase Auth identity of its own, so whichever real device is
    // in the room writes its moves on its behalf.
    function botRoom(roomCode) {
      return roomCode == '130246';
    }

    function botUid() {
      return 'karalak-bot';
    }

    match /rooms/{roomCode} {

      // Which player entries this write moves. MapDiff.affectedKeys() is the
      // one construct that lets a rule say "you may edit your own row and
      // nobody else's" without iterating the map, which rules cannot do.
      function touchedPlayers() {
        return request.resource.data.players.diff(resource.data.players).affectedKeys();
      }

      function isHost() {
        return resource.data.hostUid == request.auth.uid;
      }

      function isListed() {
        return request.auth.uid in resource.data.players;
      }

      // hostUid and createdAt are set once at creation and must survive every
      // subsequent write — without this a player could simply promote
      // themselves to host and gain the kick power below. Read through
      // .get() defaults rather than directly: the bot room is bootstrapped by
      // BotRoomEngine.resetToWaiting(), which writes no createdAt at all, and
      // a bare `resource.data.createdAt` on a missing field aborts the whole
      // rule evaluation rather than simply comparing unequal.
      function identityPreserved() {
        return request.resource.data.get('hostUid', '') == resource.data.get('hostUid', '')
               && request.resource.data.get('createdAt', 0) == resource.data.get('createdAt', 0);
      }

      // A rematch / return-to-lobby reset legitimately rebuilds the entire
      // players map, and either player may trigger it (see
      // OnlineGameRepositoryImpl.resetForRematch — it deliberately does not
      // depend on the host's screen still being open). It is only reachable
      // out of FINISHED and always clears the vote list, which is what keeps
      // this exception from being a general-purpose "rewrite everyone" hole.
      // Who is barred from the room is the host's call alone (kicking and unbanning, see isHost below): a
      // listed player who could write it could ban everyone else from coming back.
      function kickListUntouched() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['kickedUsers']);
      }

      function isRoundReset() {
        return resource.data.status == 'FINISHED'
               && request.resource.data.rematchVotes.size() == 0
               && request.resource.data.status in ['PLAYING', 'WAITING']
               && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['status', 'wordIds', 'startedAt', 'players', 'rematchVotes']);
      }

      // What a listed player who is not the host may change at the room level, besides their own row: the round
      // ending once everyone has finished (any device may notice that first), and their own rematch vote. Starting a
      // round, the word list, the countdown and the room's settings are the host's (or a round reset's).
      function playerRoomFieldsOk() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(['players', 'status', 'rematchVotes'])
               && (!changed.hasAny(['status'])
                   || (resource.data.status == 'PLAYING' && request.resource.data.status == 'FINISHED'))
               && (!changed.hasAny(['rematchVotes'])
                   || request.resource.data.rematchVotes.toSet().difference(resource.data.rematchVotes.toSet())
                        .hasOnly([request.auth.uid]));
      }

      // A room is looked up by its code (a single get) before you are a listed player, so any signed-in device may
      // read one room. Listing rooms is not needed by any client and would hand out every open room to strangers.
      allow get: if signedIn();
      allow list: if reviewer();

      // Creating a room: you must be its host, and the initial players map
      // must contain only you — except the permanent bot room, which has no
      // real owner and gets bootstrapped by whichever real player's app
      // finds it missing.
      allow create: if signedIn()
                    && (
                      (request.resource.data.hostUid == request.auth.uid
                       && request.resource.data.players.keys().hasOnly([request.auth.uid]))
                      || botRoom(roomCode)
                    );

      allow update: if signedIn()
                    && identityPreserved()
                    && (
                      // The bot room stays broadly writable by any signed-in
                      // device, deliberately: it has no owner, holds no real
                      // user data, and any device may need to drive the bot's
                      // turn, prune stragglers or repair a match stuck in
                      // PLAYING (see BotRoomEngine.runMaintenance, whose
                      // reset shapes are too varied to enumerate safely
                      // here). identityPreserved() above still applies, so
                      // even here nobody can seize hostUid. The genuinely
                      // irreplaceable asset in this feature is the training
                      // data, and that is protected at botTrainedWords below.
                      // The bot room has no host, so nobody may ban anyone from it: a ban list anyone could write
                      // would let one device lock every other player out of the shared room.
                      (botRoom(roomCode) && kickListUntouched())

                      // The host additionally owns moderation: kicking
                      // (removing another player's entry) and unbanning.
                      || isHost()

                      // A listed player edits their own row only — ready-up,
                      // presence heartbeat, their own result — or takes part
                      // in a round reset.
                      || (isListed() && kickListUntouched()
                          && ((touchedPlayers().hasOnly([request.auth.uid]) && playerRoomFieldsOk()) || isRoundReset()))

                      // A newcomer joining an open room adds exactly one
                      // entry: their own. Capacity, status and ban checks
                      // are enforced here rather than trusted to the app —
                      // the client-side check only exists for a nicer error
                      // message. Keep the size caps in sync with
                      // GameConstants.MAX_ROOM_SIZE / TEAM_ROOM_SIZE — a
                      // team room (see C5 / OnlineRoom.teamMode) is capped
                      // at 4, not 8.
                      || (
                        !isListed()
                        // joining writes the newcomer's own row and nothing else of the room
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
                        && touchedPlayers().hasOnly([request.auth.uid])
                        && resource.data.players.size() < (resource.data.get('teamMode', false) ? 4 : 8)
                        && resource.data.status in ['WAITING', 'PLAYING', 'FINISHED']
                        && (
                          !(request.auth.uid in resource.data.get('kickedUsers', {}))
                          || request.time.toMillis() > resource.data.kickedUsers[request.auth.uid].until
                        )
                      )
                    );

      allow delete: if false;

      // Whether the caller has a row in this room. The drawings and the chat of a room are for the people in it: a
      // stranger who knows (or guesses) a six-digit code must not be able to read them from outside.
      function isMember() {
        return request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomCode)).data.players;
      }

      match /results/{uid} {
        // Every player needs to read every other player's drawings; you can
        // only ever write your own result doc — except the bot's, which is
        // written on its behalf in the bot room.
        allow read: if signedIn() && (isMember() || reviewer());
        allow write: if signedIn()
                     && (request.auth.uid == uid || (botRoom(roomCode) && uid == botUid()))
                     && (!('itemsJson' in request.resource.data) || request.resource.data.itemsJson is string);
      }

      match /reactions/{reactionId} {
        // Append-only chat log: anyone in the room can read, you can only
        // post a reaction stamped with your own uid, nothing is editable.
        // Every field is named and bounded, so this collection cannot be
        // used as free bulk storage.
        allow read: if signedIn() && (isMember() || reviewer());
        allow create: if signedIn()
                      && isMember()
                      && request.resource.data.keys().hasOnly(['uid', 'emoji', 'messageKey', 'sentAt'])
                      && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8
                      && request.resource.data.messageKey is string && request.resource.data.messageKey.size() <= 64
                      && request.resource.data.sentAt is int
                      && (
                        request.resource.data.uid == request.auth.uid
                        || (botRoom(roomCode) && request.resource.data.uid == botUid())
                      );
        allow update, delete: if false;
      }
    }

    // ---- asynchronous duels (see DuelRepositoryImpl.kt) -----------------
    //
    // One player draws now, the other guesses whenever they next open the
    // app. Only the two participants can see a duel; the challenger creates
    // it and never touches it again, and the opponent may only fill in their
    // own result — they cannot rewrite the challenger's score or the words.
    match /duels/{duelId} {
      function isParticipant() {
        return request.auth.uid == resource.data.challengerUid
               || request.auth.uid == resource.data.opponentUid;
      }

      allow read: if signedIn() && isParticipant();

      // A player who blocked the challenger cannot be challenged by them, and every free-text field is bounded.
      allow create: if signedIn()
                    && request.resource.data.challengerUid == request.auth.uid
                    && request.resource.data.opponentUid is string
                    && request.resource.data.opponentUid != request.auth.uid
                    && !exists(/databases/$(database)/documents/users/$(request.resource.data.opponentUid)/blockedUsers/$(request.auth.uid))
                    && request.resource.data.status == 'AWAITING_OPPONENT'
                    && request.resource.data.opponentScore == null
                    && request.resource.data.get('challengerName', '') is string && request.resource.data.get('challengerName', '').size() <= 40
                    && request.resource.data.get('opponentName', '') is string && request.resource.data.get('opponentName', '').size() <= 40
                    && request.resource.data.get('itemsJson', '') is string && request.resource.data.get('itemsJson', '').size() < 400000
                    && request.resource.data.get('wordIds', []) is list && request.resource.data.get('wordIds', []).size() <= 50;

      // Two, and only two, transitions are ever allowed:
      allow update: if signedIn()
                    && (
                      // The opponent playing the duel. Everything the
                      // challenger committed to (words, drawings, their own
                      // score) is frozen.
                      (
                        request.auth.uid == resource.data.opponentUid
                        && resource.data.status == 'AWAITING_OPPONENT'
                        && request.resource.data.status == 'COMPLETE'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'opponentScore', 'opponentCorrectCount', 'completedAt', 'seenByChallenger'])
                      )
                      // The challenger acknowledging a completed duel's
                      // result — the only write they ever make on a duel,
                      // and the only field of it they may ever touch.
                      || (
                        request.auth.uid == resource.data.challengerUid
                        && resource.data.status == 'COMPLETE'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenByChallenger'])
                        && request.resource.data.seenByChallenger == true
                      )
                    );

      // Either participant may clear a finished duel from their own view;
      // deleting outright is how a duel leaves the list once both have seen it.
      allow delete: if signedIn() && isParticipant();
    }

    // One-time, globally unique usernames: usernames/{foldedName} →
    // { uid, name, createdAt }. Create-only (a taken name can never be
    // overwritten or re-pointed); only the owner may delete it, which is what
    // frees the name when an account is deleted.
    //
    // One account holds one name. usernameOwners/{uid} says which name that is, and it moves in the same transaction
    // as the names themselves: a name can only be created as the one the account's marker points at, and the marker
    // can only move off a name that is being released in the same write. Without it a script could reserve every
    // short or attractive name under one account. The key is the folded form of the name; whether it was folded
    // correctly cannot be checked here (rules have no Unicode normalisation), so it is held to the same shape the
    // apps produce instead.
    function usernameOwnerPath() {
      return /databases/$(database)/documents/usernameOwners/$(request.auth.uid);
    }

    match /usernames/{key} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 16
                    && key.size() >= 2 && key.size() <= 32
                    && key == key.lower()
                    && !key.matches('.*[ /].*')
                    && existsAfter(usernameOwnerPath())
                    && getAfter(usernameOwnerPath()).data.key == key;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
                    && (!existsAfter(usernameOwnerPath()) || getAfter(usernameOwnerPath()).data.key != key);
    }

    match /usernameOwners/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['key'])
                    && request.resource.data.key is string
                    && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.key))
                    && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.key)).data.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['key'])
                    && request.resource.data.key is string
                    && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.key))
                    && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.key)).data.uid == uid
                    && (resource.data.key == request.resource.data.key
                        || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.key)));
      allow delete: if signedIn() && request.auth.uid == uid
                    && !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.key));
    }

    // Permanent friend codes — a code->uid lookup doc that never rotates. One per account: the code is created in the
    // same transaction that records it on the account's own profile (as both apps already do), so a script cannot
    // claim a block of codes. The owner may delete theirs when the account is deleted.
    match /friendCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid
                    && code.matches('[0-9]{6}')
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('friendCode', '') == code
                    && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
                        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('friendCode', '') == '');
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Recorded rounds that other players get matched against — see
    // domain/model/GhostRun.kt and data/repository/GhostRunRepositoryImpl.kt.
    //
    // Flat and world-readable on purpose: a round belongs to the whole pool
    // the moment it lands, and matching is a query over all of it rather
    // than anything scoped to a friendship.
    // The review queue. Every finished round lands here first and only
    // reaches the live pool once a reviewer has looked at the drawings — the
    // automatic writing check was measured against real handwriting and does
    // not work, so a human is the only reliable filter left. See
    // GhostRunRepositoryImpl.write and ModerationRepository.
    match /pendingRuns/{runId} {
      // The queue holds drawings, uids and names that are not public until a reviewer approves them, so only the
      // reviewer and the round's own author may read an entry.
      allow read: if reviewer() || (signedIn() && resource.data.uid == request.auth.uid);
      // Either the author filing their own finished round, or the reviewer
      // sending one back out of the live pool for a second look — that copy
      // carries the ORIGINAL author's uid, so it cannot pass the first test.
      // The nickname a round carries is shown to every opponent it is matched against, so it is held to the
      // same shape the reviewer's rename is (the apps cap their own names at 16): a string, at most 40 long.
      allow create: if ((signedIn() && request.resource.data.uid == request.auth.uid)
                    || reviewer())
                    && (!('nickname' in request.resource.data)
                        || (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 40));
      // One field, one writer. The reviewer may change the name a round is
      // presented under and nothing else — while the pool is seeded largely
      // by one person's own play, every opponent otherwise carries the same
      // two or three names. The score, the words and the timestamp are what
      // the round IS and stay frozen.
      allow update: if reviewer()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname'])
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() > 0
                    && request.resource.data.nickname.size() <= 40;
      // The author may withdraw their own round (deleting the account takes these with it).
      allow delete: if reviewer() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /pendingRunItems/{runId} {
      allow read: if reviewer() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if ((signedIn() && request.resource.data.uid == request.auth.uid)
                    || reviewer())
                    && request.resource.data.itemsJson.size() < 200000;
      allow update: if false;
      allow delete: if reviewer() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Günlük Meydan Okuma review queue — see ModerationRepository's
    // daily-challenge methods. Same "readable by any signed-in client,
    // behind the app's own passcode gate rather than a rule" reasoning as
    // pendingRuns above, since this same app build is what a non-reviewer's
    // device uses to file its own attempt. No sibling "Items" collection
    // (unlike pendingRuns/pendingRunItems): a daily attempt is a handful of
    // words once a day, not worth splitting the way the far higher-volume
    // Hızlı Eşleş queue is.
    match /pendingDailyChallenges/{id} {
      allow read: if reviewer() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.itemsJson.size() < 200000;
      allow update: if false;
      // Approving or rejecting both just remove the row (see ModerationRepository.approveDailyChallenge/
      // rejectDailyChallenge); the author may also remove their own when deleting the account.
      allow delete: if reviewer() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /ghostRuns/{runId} {
      allow read: if signedIn();

      // A player can no longer write straight into the pool: a round gets
      // here by being copied out of pendingRuns during review, and only the
      // reviewer makes that copy.
      allow create: if reviewer();

      // Immutable once written, except the display name — same reasoning and
      // same narrow field as pendingRuns above. A recorded score is somebody
      // else's opponent from here on, so editing THAT after the fact would
      // let a player raise the bar (or lower it) for everyone matched
      // against them.
      allow update: if reviewer()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname'])
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() > 0
                    && request.resource.data.nickname.size() <= 40;

      // Deleting your own is what the per-player cap prunes with, and it is
      // also how account deletion takes these with it. The reviewer may also
      // delete anyone's — that is how a round goes back to the queue.
      allow delete: if reviewer()
                    || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // The drawings belonging to a recorded round, keyed by the SAME id as
    // the ghostRuns document they came from. Kept apart because they are
    // roughly a hundred times the size of the round itself and are worth
    // nothing until a match has actually been played to the end — see
    // GhostRunRepositoryImpl for why that split is what makes a search cheap.
    match /ghostRunItems/{runId} {
      allow read: if signedIn();

      // Written only as part of the reviewer's approval copy — see ghostRuns.
      // The size cap stays on it: 200000 is well above a ten-word round's
      // stroke data and well below anything that would make this collection
      // usable as free file storage.
      allow create: if reviewer()
                    && request.resource.data.itemsJson.size() < 200000;

      // Immutable for the same reason the round is: these drawings are what
      // an opponent's score was earned with.
      allow update: if false;

      // Follows the round it belongs to — pruning, account deletion, and the
      // reviewer pulling a round back into the queue all delete both halves.
      allow delete: if reviewer()
                    || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // The global weekly table, published as ONE document by the scheduled
    // buildGlobalLeaderboard function (see functions/src/index.ts). Readable
    // by anyone signed in; writable by nobody — the function runs on admin
    // credentials, which bypass these rules entirely.
    //
    // Publishing it as a single document rather than letting clients query
    // users/ directly is what keeps the screen at one read per viewer
    // instead of one per listed player.
    match /leaderboards/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // The exception: which cosmetic this week's top three win, set from the
    // review panel. Rules OR together, so this grant sits alongside the
    // blanket deny above rather than replacing it.
    match /leaderboards/config {
      allow read: if signedIn();
      allow write: if reviewer();
    }

    // The app-wide "2x XP etkinliği" toggle set from the Developer Panel
    // (see XpEventRepository) — same reviewer-write/signed-in-read shape as
    // leaderboards/config above, just a separate doc since it's unrelated
    // to the league.
    match /config/xpEvent {
      allow read: if signedIn();
      allow write: if reviewer();
    }

    // The rune map's pace (when each ring opens, the price factor): readable by everyone signed in, written by reviewers.
    match /config/economy {
      allow read: if signedIn();
      allow write: if reviewer();
    }

    match /config/runes {
      allow read: if signedIn();
      allow write: if reviewer();
    }

    // ---- the public profile and the league ---------------------------------
    //
    // The league month a score belongs to, as both apps stamp it (LeaguePeriod.periodIdFor): year * 12 + month - 1, on
    // Istanbul's calendar, which is UTC+3 all year.
    function istanbulNow() {
      return request.time + duration.value(3, 'h');
    }

    function currentPeriodId() {
      return istanbulNow().year() * 12 + istanbulNow().month() - 1;
    }

    function periodStartMillis(p) {
      return (timestamp.date(p / 12, p % 12 + 1, 1) - duration.value(3, 'h')).toMillis();
    }

    // A sanity ceiling on the fields that decide the league standings and every prize built on them. The score is
    // still published by the player's own device, so this is not a full anti-cheat (that needs the score computed on
    // a server); what it guarantees is that no account can be ahead of honest play by more than the margins below.
    function plausibleLeagueFields() {
      let before = resource == null ? {} : resource.data;
      let after = request.resource.data;
      let scoreTouched = after.diff(before).affectedKeys().hasAny(['periodXp', 'periodId']);
      return (!('periodXp' in after) || (after.periodXp is int && after.periodXp >= 0 && after.periodXp <= 300000))
             && (!('level' in after) || (after.level is int && after.level >= 1 && after.level <= 100))
             // Lifetime XP, shown on the Friends table. A sanity ceiling only (level 100 is ~252k XP).
             && (!('totalXp' in after) || (after.totalXp is int && after.totalXp >= 0 && after.totalXp <= 5000000))
             && (!scoreTouched || !('periodXp' in after) || plausibleMonthScore())
             && periodStampOk();
    }

    // How much a month's score may hold: a 30000 burst (everything that legitimately lands at once — the monthly
    // prize, referral rewards, a long offline stretch published in one go) plus 3000 an hour since the month began,
    // which no hand can reach. Measured from the START OF THE MONTH, not from the previous write: a per-write
    // allowance let a script climb to the ceiling in a handful of back-to-back writes. The same numbers decide who
    // appears in the global table and who can win it (functions/src/leagueRules.ts) — keep them in step.
    // The score must belong to the current month (or to last month during the first hour of a new one, for a device
    // whose clock runs a little behind), so nobody can pad a month that is over.
    //
    // The same allowance is also measured from the moment THIS account published its first score of the month
    // (periodStartAt, stamped by the server on that write and fixed for the rest of the month). A brand-new account —
    // which costs nothing to make — therefore opens a month at no more than the burst and cannot climb faster than
    // 3000 an hour, however many writes it sends: a per-write allowance (the earlier rule) handed out a fresh burst
    // with every write, so a script reached the ceiling in seconds. An honest player who reinstalls starts again from
    // the burst and catches up within a day (LeagueScoreCap in the app publishes what the rules accept).
    // A score change must carry the server's time stamp.
    function plausibleMonthScore() {
      let after = request.resource.data;
      let p = after.get('periodId', -1);
      let current = currentPeriodId();
      let now = request.time.toMillis();
      let freshStart = resource == null
                       || !(resource.data.get('periodStartAt', null) is timestamp)
                       || resource.data.get('periodId', -2) != p;
      let startOk = freshStart
                    ? after.get('periodStartAt', null) == request.time
                    : after.get('periodStartAt', null) == resource.data.periodStartAt;
      let startMillis = freshStart ? now : resource.data.periodStartAt.toMillis();
      return p is int
             && (p == current || (p == current - 1 && now < periodStartMillis(current) + 3600000))
             && after.periodXp is int
             && startOk
             && after.periodXp <= 30000 + (now - periodStartMillis(p)) / 1200
             && after.periodXp <= 30000 + (now - startMillis) / 1200
             && after.get('periodXpAt', null) == request.time;
    }

    // The score's time stamp must be the server's own time, or a client could backdate it.
    function periodStampOk() {
      let after = request.resource.data;
      return !('periodXpAt' in after)
             || (resource != null && 'periodXpAt' in resource.data && after.periodXpAt == resource.data.periodXpAt)
             || after.periodXpAt == request.time;
    }

    // What every player sees of an account: the name, the picture, the frame. Bounded, and the picture may only be a
    // Google profile photo — any other address would let one player log the IP of everyone who looks at the table.
    function profileFieldsOk() {
      let before = resource == null ? {} : resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return (!changed.hasAny(['nickname']) || !('nickname' in after)
                || (after.nickname is string && after.nickname.size() > 0 && after.nickname.size() <= 40))
             && (!changed.hasAny(['username']) || !('username' in after)
                || (after.username is string && after.username.size() <= 40))
             && (!changed.hasAny(['avatarUrl']) || !('avatarUrl' in after)
                || (after.avatarUrl is string
                    && (after.avatarUrl == '' || after.avatarUrl.matches('https://lh[0-9]+[.]googleusercontent[.]com/[^ ]{1,1000}'))))
             && (!changed.hasAny(['frameId']) || !('frameId' in after) || (after.frameId is string && after.frameId.size() <= 64))
             // The month's start moves only together with the score (plausibleMonthScore checks it there).
             && (!changed.hasAny(['periodStartAt']) || changed.hasAny(['periodXp', 'periodId']))
             // The friend code is the account's one code (see friendCodes) and never changes once given.
             && (!('friendCode' in before) || !('friendCode' in after) || after.friendCode == before.friendCode);
    }

    // Who invited this account, and whether the referral reward was paid for it. The invitee's own device records the
    // inviter once (FriendRepositoryImpl.recordReferralIfEligible); after that the inviter cannot be swapped and the
    // "paid" flag cannot be turned back to false — that flip is what let one account collect the reward every day.
    // (The reward cron also keeps its own ledger, referrals/{invitee}, which no client can touch.)
    function referralFieldsOk() {
      let before = resource == null ? {} : resource.data;
      let after = request.resource.data;
      return (!('invitedByUid' in after)
                || ('invitedByUid' in before && after.invitedByUid == before.invitedByUid)
                || (!('invitedByUid' in before) && after.invitedByUid is string
                    && after.invitedByUid != request.auth.uid && after.invitedByUid.size() <= 128))
             && (!('referralRewardGranted' in after)
                || ('referralRewardGranted' in before && after.referralRewardGranted == before.referralRewardGranted)
                || (!('referralRewardGranted' in before) && after.referralRewardGranted == false));
    }

    // The cloud save (users/{uid}/backup/state) is restored into the game as
    // it stands, so a hand-written one would be a free fortune. Every save is
    // stamped with the server's time (sealedAt), and between two saves gold and
    // XP may grow only by a burst plus a steady hourly rate — far above honest
    // play (a whole day of rounds, ads and chests is a few tens of thousands of
    // gold), far below a cheat. The first save of an account (nothing to
    // measure against) is held to a fixed ceiling instead. Rune levels and
    // jokers are bounded too; the game itself clamps rune levels to each rune's
    // top on restore.
    function plausibleBackup() {
      let after = request.resource.data;
      let existing = resource != null;
      let hasStamp = existing && 'sealedAt' in resource.data && resource.data.sealedAt is timestamp;
      let hours = hasStamp ? (request.time.toMillis() - resource.data.sealedAt.toMillis()) / 3600000 : 0;
      let goldBefore = (hasStamp && 'goldBalance' in resource.data) ? resource.data.goldBalance : 0;
      let xpBefore = (hasStamp && 'lifetimeXp' in resource.data) ? resource.data.lifetimeXp : 0;
      return after.sealedAt == request.time
             && after.goldBalance is int && after.goldBalance >= 0 && after.goldBalance <= 20000000
             && after.lifetimeXp is int && after.lifetimeXp >= 0 && after.lifetimeXp <= 5000000
             && (hasStamp
                 ? (after.goldBalance - goldBefore <= 300000 + hours * 60000
                    && after.lifetimeXp - xpBefore <= 30000 + hours * 3000)
                 // A first save has nothing to measure growth against. Saves can no longer be deleted (delete: false
                 // below), so this is once per account; held to what a long-standing honest player could hold.
                 : (after.goldBalance <= 500000 && after.lifetimeXp <= 1000000))
             && (!('runeLevels' in after) || (after.runeLevels is map && after.runeLevels.size() <= 40))
             && (!('jokerCounts' in after) || (after.jokerCounts is list && after.jokerCounts.size() <= 20));
    }

    // A name shown to other players: a non-empty string of at most 40 characters (the apps cap their own at 16).
    function shortName(value) {
      return value is string && value.size() > 0 && value.size() <= 40;
    }

    match /users/{uid} {
      // Public profile: nickname, friendCode, level/frame, and the monthly
      // league score. Readable by anyone signed in — that is what lets a
      // friend list resolve nicknames and badges, and the global league count
      // the players ahead of you — and writable only by its owner, within the
      // checks above. Note this document deliberately holds NOTHING private:
      // the FCM token lives in the private/ subcollection below precisely
      // because this one is world-readable.
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
                            && plausibleLeagueFields() && profileFieldsOk() && referralFieldsOk();
      // The reviewer may put a neutral name on an account whose name was reported (developer panel, "Adı sıfırla").
      allow update: if reviewer()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'username', 'nameResetAt'])
                    && shortName(request.resource.data.nickname);
      // Deleting the account takes the public profile with it.
      allow delete: if signedIn() && request.auth.uid == uid;

      // Device push token and anything else that must not be world-readable.
      // Cloud Functions read this with admin credentials, which bypass rules,
      // so locking it to the owner costs the push pipeline nothing.
      match /private/{docId} {
        allow read: if signedIn() && request.auth.uid == uid;
        // leagueAwards and pendingRewards are documents here the owner may
        // not freely write: leagueAwards records what they won (written by
        // finalizeLeaguePeriod with admin credentials — owner-writable, it
        // would be a cosmetics vending machine), and pendingRewards is a
        // reward queue only the referral cron may add to (see the dedicated
        // match below for how the owner may still consume it). The owner may
        // delete either: that is part of deleting the account.
        allow create, update: if signedIn() && request.auth.uid == uid
                              && docId != 'leagueAwards' && docId != 'pendingRewards' && docId != 'age';
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // The player's date of birth, bound to their Google account (AccountAgeSync): saved once from the date the
      // device was given, so the age rules follow the account to a reinstall or a new phone. Month and day may be
      // missing (an answer given as a year only). It cannot be rewritten while it says the player may still be under
      // 18, so a fresh install that is told an older age does not overwrite it. The owner may delete it: that is part
      // of deleting the account.
      function validAgeDoc() {
        let d = request.resource.data;
        return d.keys().hasOnly(['birthYear', 'birthMonth', 'birthDay', 'savedAt'])
               && d.birthYear is int
               && d.birthYear >= request.time.year() - 110
               && d.birthYear <= request.time.year()
               && (!('birthMonth' in d) || (d.birthMonth is int && d.birthMonth >= 1 && d.birthMonth <= 12))
               && (!('birthDay' in d) || (d.birthDay is int && d.birthDay >= 1 && d.birthDay <= 31))
               && ('birthMonth' in d) == ('birthDay' in d)
               && d.savedAt == request.time;
      }
      match /private/age {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid && validAgeDoc();
        allow update: if signedIn() && request.auth.uid == uid && validAgeDoc()
                      && resource.data.birthYear <= request.time.year() - 19;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // Rewards a Blaze-free cron script (runGrantReferralRewards, admin
      // credentials bypass rules) has granted this account but can't write
      // straight onto the public profile — see LeagueScorePublisher's own
      // doc comment for why a server-side XP write there would just be
      // overwritten on the client's next publish. The owner may read it and
      // may shrink `pending` (after applying each entry locally, see
      // ReferralRewardClaimer) but never grow it or touch any other field.
      match /private/pendingRewards {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if false;
        allow update: if signedIn() && request.auth.uid == uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pending'])
                      && request.resource.data.pending.size() <= resource.data.pending.size();
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // Cloud save of local progress (XP, achievements, level stars,
      // cosmetics) so a new phone can restore it. Strictly owner-only — and,
      // since a restore puts these numbers straight back into the game, held
      // to plausibleBackup(). Not deletable from a client: deleting it and
      // writing a "first save" again used to reset the growth limit and hand
      // out the first-save ceiling as often as wanted. Account deletion
      // removes it on the server (functions/src/maintenance.ts).
      match /backup/{docId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid && plausibleBackup();
        allow delete: if false;
      }

      // A friendship is two documents, one in each player's list. You write your own list freely; you may write
      // YOUR entry into someone else's list only when they asked for it:
      //  - accepting: the owner's friend request sits in your inbox (users/{you}/friendRequests/{owner});
      //  - moving accounts: a guest who signs in to an existing Google account re-creates their friendships under the
      //    new uid. The old uid leaves a one-time secret in its private/migration document before switching, the new
      //    uid presents the same secret in its own private/migratedFrom, and only lists that already hold the old uid
      //    can be written. Nobody else can read either document, so nobody else can present the secret.
      // Before this, anyone could write themselves into anyone's list — even a player who had blocked them.
      function migratedFromUid() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)/private/migratedFrom).data.uid;
      }

      function isSuccessorOf(oldUid) {
        let mine = /databases/$(database)/documents/users/$(request.auth.uid)/private/migratedFrom;
        let theirs = /databases/$(database)/documents/users/$(oldUid)/private/migration;
        return exists(mine) && exists(theirs)
               && get(mine).data.uid == oldUid
               && get(theirs).data.token is string && get(theirs).data.token.size() >= 16
               && get(mine).data.token == get(theirs).data.token;
      }

      match /friends/{friendUid} {
        function validEntry() {
          return request.resource.data.keys().hasOnly(['nickname', 'addedAt'])
                 && shortName(request.resource.data.nickname)
                 && (!('addedAt' in request.resource.data) || request.resource.data.addedAt is int);
        }

        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && validEntry()
                              && (request.auth.uid == uid
                                  || (request.auth.uid == friendUid
                                      && !exists(/databases/$(database)/documents/users/$(uid)/blockedUsers/$(request.auth.uid))
                                      && (exists(/databases/$(database)/documents/users/$(friendUid)/friendRequests/$(uid))
                                          || (exists(/databases/$(database)/documents/users/$(uid)/friends/$(migratedFromUid()))
                                              && isSuccessorOf(migratedFromUid())))));
        // Either side may end a friendship; the successor of a moved account removes the old uid's entries.
        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == friendUid || isSuccessorOf(friendUid));
      }

      match /friendRequests/{fromUid} {
        // Entering someone's friend code no longer makes you their friend —
        // it writes one document here and stops. Only the recipient can read
        // these, and only they can turn one into a friends/ entry, which is
        // the whole point: a six-digit code that anyone can pass around must
        // not by itself put a stranger in your list.
        //
        // Blocked senders are refused for the same reason as invites below.
        // There is deliberately no cooldown: a friend request is answered
        // once and disappears, so it cannot be used to nag the way a repeated
        // match invite could.
        allow read: if signedIn() && request.auth.uid == uid;
        // The sender may withdraw their own pending request; the recipient
        // may decline it or clear it on accept.
        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == fromUid);
        // fromUid repeats the sender inside the document so that deleting the sender's account can find every request
        // they left in other players' inboxes (older requests do not have it).
        allow create: if signedIn()
                      && fromUid == request.auth.uid
                      && fromUid != uid
                      && request.resource.data.keys().hasOnly(['fromNickname', 'sentAt', 'fromUid'])
                      && shortName(request.resource.data.fromNickname)
                      && (!('fromUid' in request.resource.data) || request.resource.data.fromUid == request.auth.uid)
                      && !exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid))
                      && !exists(/databases/$(database)/documents/users/$(uid)/blockedUsers/$(request.auth.uid));
        allow update: if false;
      }

      match /invites/{inviteId} {
        // Only the recipient reads/dismisses their own invites. A match invite
        // comes from a friend — the recipient must have the sender in their
        // friends list — stamped with the sender's own uid, and never from
        // someone the recipient blocked or declined within the last 5 minutes
        // (keep the 300000ms window in sync with
        // GameConstants.FRIEND_INVITE_COOLDOWN_MILLIS).
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
                      && request.resource.data.keys().hasOnly(['fromUid', 'fromNickname', 'roomCode', 'sentAt'])
                      && request.resource.data.fromUid == request.auth.uid
                      && shortName(request.resource.data.fromNickname)
                      && request.resource.data.roomCode is string && request.resource.data.roomCode.matches('[0-9]{6}')
                      && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid))
                      && !exists(/databases/$(database)/documents/users/$(uid)/blockedUsers/$(request.auth.uid))
                      && (
                        !exists(/databases/$(database)/documents/users/$(uid)/inviteCooldowns/$(request.auth.uid))
                        || request.time.toMillis() > get(/databases/$(database)/documents/users/$(uid)/inviteCooldowns/$(request.auth.uid)).data.declinedAt + 300000
                      );
        allow update: if false;
      }

      match /blockedUsers/{blockedUid} {
        // The owner manages their own block list. The blocked person can read
        // their own entry (but nobody else's) so a would-be sender can show a
        // friendly "this person blocked you" message instead of a raw
        // permission error.
        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == blockedUid);
        allow create, update: if signedIn() && request.auth.uid == uid
                              && (!('nickname' in request.resource.data) || request.resource.data.nickname is string
                                  && request.resource.data.nickname.size() <= 40);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /inviteCooldowns/{fromUid} {
        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == fromUid);
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    // An account's request to be deleted. Written by the account itself right before it signs out for good (both
    // apps' "Delete account"); the daily maintenance run (functions/src/maintenance.ts runProcessDeletions) then removes
    // everything the account left behind — including what a client cannot reach — and the sign-in itself.
    match /deletionRequests/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['requestedAt', 'platform'])
                    && request.resource.data.requestedAt == request.time
                    && (!('platform' in request.resource.data)
                        || request.resource.data.platform in ['android', 'web']);
      allow update, delete: if false;
    }

    // A player reporting another player (their name, or how they behave in a room) — the user-to-user reporting Play
    // requires of an app with online play. One report per reporter and player: the id is {reportedUid}__{reporterUid}.
    match /playerReports/{reportId} {
      allow read, delete: if reviewer();
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['reporterUid', 'reportedUid', 'nickname', 'reason', 'context', 'createdAt'])
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.reportedUid is string
                    && request.resource.data.reportedUid != request.auth.uid
                    && reportId == request.resource.data.reportedUid + '__' + request.auth.uid
                    && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 40
                    && request.resource.data.reason in ['NAME', 'BEHAVIOUR', 'CHEATING', 'OTHER']
                    && (!('context' in request.resource.data)
                        || (request.resource.data.context is string && request.resource.data.context.size() <= 32))
                    && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    // Bot-opponent training data: one doc per word id, holding the hand-drawn
    // stroke data the bot replays as its own drawing in the bot room.
    //
    // This is many hours of irreplaceable manual work (see the "Bot Eğitim"
    // screen) sitting behind anonymous auth, so deletion is closed off
    // entirely — an earlier revision granted blanket `write`, which meant any
    // signed-in device on earth could erase the lot. Creating and re-training
    // a word stay open (that is the whole point of the shared training
    // screen), but a write must actually look like training data and stay
    // under a sane size, so the collection cannot be repurposed as free
    // storage.
    // SEALED. Every word is trained (1148 of them) and the Bot Eğitim screen
    // that writes here is unreachable in the shipping app, so nothing in the
    // client needs write access any more — and leaving it open meant every
    // player, who is signed in anonymously the moment they open the game,
    // could overwrite any drawing in the set. Nobody had a reason to; they
    // simply could, and this data cannot be regenerated by hand.
    //
    // The last writer was BotTrainingRepositoryImpl.saveTraining, reached
    // only from that screen. To train a new batch of words: put the two
    // `allow create, update` lines below back (they are kept commented so
    // the size cap is not re-derived from scratch), bring back the screen as
    // NavGraph's Screen.BotTraining comment describes, train, then seal both
    // again and ship.
    match /botTrainedWords/{wordId} {
      allow read: if signedIn();
      // 500000 (was 200000): a careful, untimed training drawing routinely
      // exceeded the old cap even after the client-side point-thinning in
      // BotTrainingRepositoryImpl.saveTraining, which made every save fail
      // with a bare PERMISSION_DENIED — surfaced to the trainer as an
      // unhelpful "Kaydedilemedi, tekrar dene" no retry could ever fix.
      // Keep BotTrainingRepositoryImpl.MAX_STROKES_JSON_LENGTH (480000) in
      // sync with — and below — this cap.
      //
      // allow create, update: if signedIn()
      //                       && request.resource.data.keys().hasAll(['wordId', 'strokesJson'])
      //                       && request.resource.data.strokesJson is string
      //                       && request.resource.data.strokesJson.size() < 500000;
      allow create, update, delete: if false;
    }

    // Mirror of botTrainedWords' doc ids in one small doc, so the training
    // screen does not have to download every stored drawing just to work out
    // which words are left. Written in the same batch as the drawing itself.
    //
    // Sealed with it, and this one mattered more than its size suggests: it
    // is a SINGLE document, so one bad write replaced the whole index — and
    // GhostRunRepositoryImpl reads it to build the fallback opponent that
    // Hızlı Eşleş falls back on when the pool is empty. Losing it would have
    // taken that fallback down with it.
    match /botTrainingIndex/{docId} {
      allow read: if signedIn();
      // allow create, update: if signedIn();
      allow create, update, delete: if false;
    }

    // In-app "Sorun Bildir" submissions. Stamped with the sender's uid so
    // they can read back the developer's reply (see C12 / ReportBugScreen);
    // nobody can read anyone else's report, and nothing is editable by the
    // client once sent — the reply field is written from the Firebase console
    // or with admin credentials, both of which bypass rules.
    // One player's report of another player's drawing — the human backstop to
    // WrittenWordDetector, and the in-app reporting path Play requires of an
    // app that shows user-generated content to strangers.
    //
    // The document id is `{scopeKey}__{reporterUid}` (see DrawingReports.idFor)
    // and the rule below enforces that suffix. That is what makes "two
    // DIFFERENT players reported this" true rather than merely hoped for:
    // reporting the same round twice rewrites one document instead of adding
    // a second, so nobody can retire a stranger's round on their own.
    // One round WrittenWordDetector refused, written down so that "it never
    // fires" can be told apart from "it is broken" — the log line it used to
    // leave behind lived and died on one device. Carries the per-word scores
    // and one sample drawing, which is also the second source (alongside
    // reports) of real handwriting to re-check the thresholds against.
    // One rejected round, applied by the offending device the next time it
    // opens the app (see PenaltyRepositoryImpl). Deliberately a record rather
    // than a command: a device offline for a week still applies it on return,
    // and one that already applied it never applies it twice.
    match /penalties/{penaltyId} {
      // A player reads only their own; the reviewer writes them.
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || reviewer());
      // Reviewer only. This used to be any signed-in player, which meant
      // anybody could write a penalty against anybody else and have their XP
      // taken away the next time they opened the app.
      allow create: if reviewer();
      // The account it is about may set `appliedAt` and nothing else. That
      // one field is what makes "applied exactly once" survive a reinstall:
      // a local flag would be gone with the old install and the XP would come
      // off a second time. Everything else stays immutable, so a penalty
      // cannot be softened or withdrawn by its own target.
      // The reviewer may also edit one (cancelling a lockout from the developer panel).
      allow update: if reviewer()
                    || (signedIn()
                        && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appliedAt'])
                        && resource.data.appliedAt == 0);
      allow delete: if false;
    }

    // Lifetime rejections per account. Never cleared — an approval does not
    // wipe it, or somebody could alternate a cheated round with an honest one
    // and never reach a lockout.
    match /moderationStrikes/{uid} {
      // Owner or reviewer only: a strike count is nobody else's business.
      allow read: if signedIn() && (request.auth.uid == uid || reviewer());
      // Same reasoning as penalties: a count anybody could raise is a count
      // anybody could use to get somebody else locked out.
      allow create, update, delete: if reviewer();
    }

    match /detectorEvents/{eventId} {
      // A moderation record with a sample of the player's handwriting: the reviewer's alone to read.
      allow read: if reviewer();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.sampleStrokesJson is string
                    && request.resource.data.sampleStrokesJson.size() <= 60000;
      // A record of a moment; never edited, and never withdrawn by the device
      // whose round it describes.
      allow update, delete: if false;
    }

    match /drawingReports/{reportId} {
      // Readable by any signed-in player because the matching query counts
      // them on the way into a match (GhostRunRepositoryImpl.findOpponent).
      // Nothing here is private: a uid, a word, and the drawing already shown
      // to everyone who played against it.
      allow read: if signedIn();

      // reporterLinked says whether the reporter is signed in with a real account (Google or a browser account)
      // rather than an anonymous guest; it cannot be claimed falsely. Only linked reports count towards taking a
      // round out of the pool automatically — two free anonymous accounts must not be enough to retire anyone's
      // round (see GhostRunRepositoryImpl). Every report still reaches the reviewer.
      allow create: if signedIn()
                    && request.resource.data.reporterUid == request.auth.uid
                    && reportId.matches('.*__' + request.auth.uid)
                    && (!('reporterLinked' in request.resource.data)
                        || request.resource.data.reporterLinked == false
                        || request.auth.token.firebase.sign_in_provider != 'anonymous')
                    && request.resource.data.reason in ['WRITTEN', 'OFFENSIVE', 'MEANINGLESS']
                    && request.resource.data.reportedUid is string
                    && request.resource.data.runId is string
                    && request.resource.data.strokesJson is string
                    && request.resource.data.strokesJson.size() <= 60000;

      // A report is a fact about a moment; it is never edited, and it is not
      // withdrawable — being able to take one back would let a reporter
      // un-retire a round on request.
      allow update: if false;
      // Only the reviewer can clear one — upholding it (with a penalty) or throwing it out.
      allow delete: if reviewer();
    }

    // Kupon kodları. Bir kod, belgenin kendisidir (coupons/{KOD}): oyuncu tek bir kodu okuyabilir ama kodları
    // listeleyemez, yani tahmin yürütmekten başka yoldan kod bulamaz. Kullanım sayacı yalnızca bir artar ve
    // yalnızca aynı işlemde bu hesabın redemptions belgesiyle birlikte; bu yüzden bir kod maxUses'tan fazla ve
    // aynı hesapla iki kez kullanılamaz. Kod oluşturmak sadece geliştirici hesabına açık.
    match /coupons/{code} {
      allow get: if signedIn();
      allow list, create, delete: if reviewer();
      allow update: if reviewer()
                    || (signedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
                        && request.resource.data.usedCount == resource.data.usedCount + 1
                        && request.resource.data.usedCount <= resource.data.maxUses
                        && (resource.data.expiresAt == 0 || request.time.toMillis() < resource.data.expiresAt)
                        && existsAfter(/databases/$(database)/documents/coupons/$(code)/redemptions/$(request.auth.uid)));

      match /redemptions/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if reviewer();
        allow create: if signedIn()
                      && request.auth.uid == uid
                      && get(/databases/$(database)/documents/coupons/$(code)).data.usedCount
                         < get(/databases/$(database)/documents/coupons/$(code)).data.maxUses
                      && getAfter(/databases/$(database)/documents/coupons/$(code)).data.usedCount
                         == get(/databases/$(database)/documents/coupons/$(code)).data.usedCount + 1;
        allow update, delete: if false;
      }
    }

    match /bugReports/{reportId} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.category in ['SUGGESTION', 'COMPLAINT']
                    && request.resource.data.description is string
                    && request.resource.data.description.size() > 0
                    && request.resource.data.description.size() <= 2000;
      // Its author reads their own; the reviewer reads all of them, which is
      // what makes the developer panel's Öneri tab possible without anyone
      // opening the Firestore console.
      allow read: if reviewer()
                  || (signedIn() && resource.data.uid == request.auth.uid);
      // The only edit any client can make: the reviewer marking a report
      // seen from the panel's "görüldü" button. hasOnly() keeps this from
      // becoming a general write hole — a report's own author still cannot
      // touch it, and the reviewer cannot touch anything but this one field.
      allow update: if reviewer()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAtMillis'])
                    && request.resource.data.seenAtMillis is int;
      // Its own author can clear it from their history; the reviewer can
      // clear it from the panel (single or "delete all", same rule either
      // way — the client just calls this once per document).
      allow delete: if reviewer()
                    || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // The curated bot-nickname pool the reviewer types into by hand from
    // Bot İsimleri (see BotNamesGate) — replaces the old procedurally
    // generated names (BOT_NAME_PREFIX/SUFFIX in functions/src/index.ts).
    // Reviewer-only end to end: unlike bugReports/drawingReports, nothing
    // here is player-submitted, and the in-app passcode gate in front of the
    // screen is explicitly NOT a security control (see DeveloperAccess.kt),
    // so this rule is the actual boundary.
    match /botNames/{nameId} {
      allow read, delete: if reviewer();
      allow create, update: if reviewer()
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40;
    }

    // Daily counters behind the developer panel's İstatistik tab (AdminStats.kt):
    // ad requests / payouts / estimated revenue per placement, app opens, finished
    // games. Each device keeps its own row for the day (devices/{uid}) and the panel
    // adds the rows up, capping any single device at a plausible amount. The day's
    // document itself used to be the one every device added to — any player could
    // then overwrite everyone's numbers, and every device in the world wrote to a
    // single document — so it is read-only now (older days keep their totals there).
    // Reading is the reviewer's alone: ad revenue is nobody else's business.
    // What the developer panel asks the cron script to do with admin credentials (grant a player gold or XP, send a
    // push to everyone). The panel writes the request; .github/workflows/league-scheduler.yml's
    // process-admin-commands runs it and stamps `doneAt`. Reviewer only.
    match /adminCommands/{id} {
      allow read, delete: if reviewer();
      allow create: if reviewer()
                    && request.resource.data.keys().hasOnly(['type', 'uid', 'gold', 'xp', 'note', 'title', 'body', 'by', 'createdAt'])
                    && request.resource.data.type in ['grant', 'broadcast']
                    && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    // Who did what in the developer panel. Append-only, reviewer only.
    match /adminAudit/{id} {
      allow read: if reviewer();
      allow create: if reviewer()
                    && request.resource.data.keys().hasOnly(['action', 'target', 'detail', 'by', 'at'])
                    && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Written by the cron script (admin credentials): the per-day roll-up of adminStats, and the last run of each job.
    match /adminSummary/{day} {
      allow read: if reviewer();
      allow write: if false;
    }
    match /adminJobs/{name} {
      allow read: if reviewer();
      allow write: if false;
    }

    // A banner on the home screen, set from the developer panel.
    match /config/announcement {
      allow read: if signedIn();
      allow write: if reviewer();
    }

    // XP events planned ahead; the cron script switches config/xpEvent on when one is due.
    match /xpEventPlans/{id} {
      allow read, write: if reviewer();
    }

    match /adminStats/{day} {
      allow read: if reviewer();
      allow create, update, delete: if false;

      match /devices/{uid} {
        allow read: if reviewer();
        allow create, update: if signedIn() && request.auth.uid == uid
                              && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                              && request.resource.data.keys().hasOnly(['day', 'uid', 'counts'])
                              && request.resource.data.day == day
                              && request.resource.data.get('uid', uid) == uid
                              && request.resource.data.counts is map
                              && request.resource.data.counts.size() <= 300;
        allow delete: if false;
      }

      // One empty marker per player per day: the number of documents here is that
      // day's distinct active players (read with a count() query, no document reads).
      match /users/{uid} {
        allow read: if reviewer();
        allow create: if signedIn() && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }
  }
}
