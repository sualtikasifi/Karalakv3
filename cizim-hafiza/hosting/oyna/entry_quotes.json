{"tr":[["Çizim yeteneğin kadar","şansın da var. İkisi de yoksa","en azından özgüvenin olsun!"],["Burada herkes sanatçı.","Kimse ne çizdiğini anlamıyor","ama herkes çok emin."],["Bu bir kedi mi,","yoksa patates mi?"],["Çizimin berbat olabilir","ama kazandığında kimse","bunu hatırlamayacak."],["Mona Lisa’nın gülümsemesi","bile bu kadar gizemli değildi.","Çiz, tahmin et, kazan!"],["Bir çizgi, bir tahmin,","bir sürü kahkaha.","Karalama Savaşları başlasın!"],["Kalemin ucu kırılabilir,","ama özgüvenin asla!"],["Beynin ‘ördek’ diyor,","elin ‘bulut’ çiziyor.","Kazanan belli değil!"],["Zaman daralıyor,","kalem titriyor,","arkadaşlar kıkırdıyor."],["Leonardo da Vinci olmana","gerek yok. Sadece rakiplerinden","daha az kötü çiz!"],["Sanat galerisi değil bu,","ama kahkaha garantili!"],["Çizimin anlaşılmazsa","‘soyut sanat’ de, kurtul."],["Yanlış anlaşılmak","sanatçıların kaderidir.","Yine de çiz!"]],"en":[["Your luck matches your drawing skill.","If you have neither,","at least have confidence!"],["Everyone here is an artist.","Nobody knows what anyone drew,","but everyone is very sure."],["Is this a cat","or a potato?"],["Your drawing may be terrible,","but when you win,","no one will remember."],["Even the Mona Lisa’s smile","wasn’t this mysterious.","Draw, guess, win!"],["One line, one guess,","lots of laughs.","Let the Doodle Wars begin!"],["Your pencil tip may break,","but your confidence never will!"],["Your brain says ‘duck’,","your hand draws ‘cloud’.","No clear winner!"],["Time is running out,","the pen is trembling,","friends are giggling."],["You don’t have to be","Leonardo da Vinci. Just draw","less badly than your rivals!"],["This is no art gallery,","but laughs are guaranteed!"],["If nobody gets your drawing,","call it ‘abstract art’","and walk away."],["Being misunderstood is","the fate of every artist.","Draw anyway!"]],"pt":[["Sua sorte combina com seu talento para desenhar.","Se não tiver nenhum dos dois,","pelo menos tenha confiança!"],["Todo mundo aqui é artista.","Ninguém sabe o que o outro desenhou,","mas todos têm muita certeza."],["Isso é um gato","ou uma batata?"],["Seu desenho pode estar horrível,","mas quando você ganhar,","ninguém vai lembrar."],["Nem o sorriso da Mona Lisa","era tão misterioso.","Desenhe, adivinhe, vença!"],["Um traço, um palpite,","muitas risadas.","Que comece a Guerra dos Rabiscos!"],["A ponta do seu lápis pode quebrar,","mas sua confiança, nunca!"],["Seu cérebro diz ‘pato’,","sua mão desenha ‘nuvem’.","Ninguém sabe quem vence!"],["O tempo está acabando,","o lápis está tremendo,","os amigos estão rindo."],["Você não precisa ser","Leonardo da Vinci. Só desenhe","menos mal que seus rivais!"],["Isto não é uma galeria de arte,","mas as risadas são garantidas!"],["Se ninguém entender seu desenho,","chame de ‘arte abstrata’","e vá embora."],["Ser incompreendido é","o destino de todo artista.","Desenhe mesmo assim!"]],"es":[["Tu suerte va a la par de tu talento para dibujar.","Si no tienes ninguno,","¡al menos ten confianza!"],["Aquí todos son artistas.","Nadie sabe qué dibujó el otro,","pero todos están muy seguros."],["¿Eso es un gato","o una papa?"],["Tu dibujo puede ser horrible,","pero cuando ganes,","nadie lo recordará."],["Ni la sonrisa de la Mona Lisa","era tan misteriosa.","¡Dibuja, adivina, gana!"],["Un trazo, una respuesta,","muchas risas.","¡Que empiece la Guerra de Garabatos!"],["La punta de tu lápiz puede romperse,","¡pero tu confianza nunca!"],["Tu cerebro dice ‘pato’,","tu mano dibuja ‘nube’.","¡Nadie sabe quién gana!"],["El tiempo se acaba,","el lápiz tiembla,","los amigos se ríen."],["No tienes que ser","Leonardo da Vinci. ¡Solo dibuja","menos mal que tus rivales!"],["Esto no es una galería de arte,","¡pero las risas están garantizadas!"],["Si nadie entiende tu dibujo,","llámalo ‘arte abstracto’","y vete."],["Ser incomprendido es","el destino de todo artista.","¡Dibuja de todos modos!"]]}